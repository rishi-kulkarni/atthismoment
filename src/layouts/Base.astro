---
import { Image } from 'astro:assets';
import Nav from '../components/Nav.astro';
import logo from '../../content/logo.png';
import { getSite } from '../lib/content.js';
import '../styles/global.css';

const site = getSite();
const { title, description } = Astro.props;

const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — ${site.tagline}`;
const pageDescription = description ?? site.description;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="wordmark" href="/">
          <Image class="wordmark__logo" src={logo} alt="" height={48} />
          <span class="wordmark__text">
            {site.title}
            <span>{site.tagline}</span>
          </span>
        </a>
        <Nav />
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          {
            site.contacts?.map((contact) => (
              <div>
                <h2>{contact.name}</h2>
                <p>
                  <a href={`mailto:${contact.email}`}>{contact.email}</a>
                </p>
                {contact.phone && <p>{contact.phone}</p>}
                <p class="handles">{contact.handles}</p>
              </div>
            ))
          }
          <div>
            <h2>Presented by</h2>
            <p>
              <a href={site.presented_by?.url}>{site.presented_by?.full_name}</a>
            </p>
            <p class="handles">Lexington, Massachusetts</p>
          </div>
        </div>

        <p class="colophon">
          © {year} {site.presented_by?.full_name}. Artwork remains the copyright of the
          individual artists.
        </p>
      </div>
    </footer>
  </body>
</html>
