<Base title="Page not found">
  <div class="wrap page-head">
    <p class="eyebrow">404</p>
    <h1 class="block-title">That page has come down</h1>
    <p class="page-head__sub">
      The link may be out of date. Try the <a href="/galleries/">online galleries</a> or the
      <a href="/artists/">artist index</a>.
    </p>
  </div>
</Base>
